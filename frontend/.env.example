# Full API prefix, including /api/v1. Example: https://www.hirees.com/api/v1
VITE_API_URL=https://www.hirees.com/api/v1
# Optional. Public Google OAuth client id for the resume upload box.
VITE_GOOGLE_CLIENT_ID=
# Where the Vite dev server proxies /api, /sitemap.xml, /jobs.xml, and /robots.txt.
VITE_DEV_API=http://127.0.0.1:3001
