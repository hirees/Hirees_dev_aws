PORT=3001
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SECRET_KEY=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CLOUD=
API_KEY=
API_SECRET=
MONGO_URI=
# DynamoDB table that stores testimonial and issue submissions.
# Partition key: id (String). Set this to the live table name.
FEEDBACK_TABLE=Feedback_dev
# Partition key: email (String).
NEWSLETTER_TABLE=Newsletter_dev

# Public site origin used in canonical URLs, sitemap, and the job feed.
SITE_URL=https://www.hirees.com

# Resume upload (Cloudinary). Same names the existing Cloudinary client reads.
CLOUD=
API_KEY=
API_SECRET=
RESUME_UPLOAD_TABLE=ResumeUploads_dev
MAGIC_LINK_TABLE=MagicLinks_dev
USERS_TABLE=Users_dev
# Server-side Gemini key for resume parsing. Do not commit a value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Public Google OAuth client id. The same value goes in the frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Set MAGIC_LINK_DEBUG=true only on a private machine to skip sending mail.
MAGIC_LINK_DEBUG=

# Google Indexing API. Leave disabled until a Search Console owner creates a service account.
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=
